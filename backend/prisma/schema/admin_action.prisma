// ==============================
// 7. ADMIN ACTION MODULE
// ==============================

enum PublicAnnouncementType {
  DAILY
  AUTHORITY
  APP
}

model PublicAnnouncement {
  announcementId String @id @default(uuid()) @db.Uuid @map("announcement_id")
  title          String  @db.VarChar(255)
  caption        String? @map("text_content")
  documentUrl    String? @map("document_url")
  publishedBy    String  @db.Uuid @map("publisher_id")
  type           PublicAnnouncementType
  createdAt      DateTime @default(now()) @map("created_at")

  publisher User @relation("PublicAnnouncementPublisher", fields: [publishedBy], references: [userId])

  @@map("PublicAnnouncement")
}


model StateModification {
  modificationId   String   @id @default(uuid()) @db.Uuid @map("deact_id")
  accountId String   @map("account_id")
  modifyBy   String   @map("modify_by")
  newState String
  modifyAt   DateTime @default(now()) @map("modify_at")

  @@map("StateModification")
}